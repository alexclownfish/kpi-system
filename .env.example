# 复制为 .env 后再部署。不要提交真实 .env。
APP_ENV=production
COMPOSE_PROJECT_NAME=kpi-system
# 默认初始化原表九部门、十八部门岗位和十八套模板，不创建演示员工。
# 已有其它公司业务目录或隔离测试环境可设置 false。
SEED_HONGXING_CATALOG=true

# 新考核流程开关：disabled=完全关闭，audit=仅开放只读审计，enabled=允许新流程写入。
# 首次升级生产环境建议保持 audit，完成审计和演练后再切换 enabled。
EVALUATION_WORKFLOW_MODE=audit

# 使用 `openssl rand -base64 48` 生成，生产环境至少 32 个字符。
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# 多个来源用逗号分隔，必须包含协议，不要带末尾斜杠。
CORS_ALLOWED_ORIGINS=https://kpi.example.com

# 项目 Nginx 的 HTTP 监听。若前方有宿主机 Nginx/Caddy，建议绑定 127.0.0.1。
KPI_HTTP_BIND=127.0.0.1
KPI_HTTP_PORT=8088

# 仅首次全新部署使用。密码从未纳入镜像和 Git 的文件中读取。
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=admin
BOOTSTRAP_ADMIN_PASSWORD_FILE=/run/kpi-secrets/bootstrap_admin_password

# 兼容已有数据库中提升现有账号的旧配置；新部署留空。
BOOTSTRAP_SUPER_ADMIN_EMAIL=

# PostgreSQL 部署使用 docker-compose.postgres.yml 叠加文件；旧 SQLite 部署不受影响。
# 迁移旧数据时，先只启动 PostgreSQL、完成迁移，再启动应用。
# 首次部署推荐独立项目名 kpi-system-pg，避免复用旧 SQLite 环境的数据卷。
# COMPOSE_PROJECT_NAME=kpi-system-pg
PG_DATABASE=kpi
PG_ADMIN_USER=kpi_admin
PG_USER=kpi_app
# 两个不同的密码文件：pg-admin-secrets/postgres_admin_password 仅 PG 容器可见；
# secrets/postgres_password 供受限应用角色使用。均为 600，不要写进 .env。
