FROM golang:1.23-bookworm AS builder
WORKDIR /app
COPY server/ ./
# 配置国内 Go 模块代理（关键）
ENV GOPROXY=https://goproxy.cn,direct
ENV GIN_MODE=release
RUN go mod tidy
RUN go test ./...
RUN CGO_ENABLED=1 go build -o kpi-server main.go

FROM debian:bookworm-slim
WORKDIR /app
RUN sed -i 's|deb.debian.org/debian-security|mirrors.aliyun.com/debian-security|g; s|deb.debian.org/debian|mirrors.aliyun.com/debian|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=3 -o Acquire::http::Timeout=30 update \
    && apt-get install -y --no-install-recommends ca-certificates chromium fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/kpi-server /app/kpi-server
RUN mkdir -p /app/db /app/exports /app/uploads/evaluation-confirmations
ENV GIN_MODE=release
ENV SYSTEM_MODE=standalone
EXPOSE 8080
CMD ["/app/kpi-server"]
